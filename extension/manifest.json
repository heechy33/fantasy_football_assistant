{
  "manifest_version": 3,
  "name": "FFA ESPN Draft Recon",
  "version": "0.1.1",
  "description": "Read-only ESPN draft reconnaissance for Fantasy Football Assistant.",
  "permissions": ["storage"],
  "host_permissions": ["https://lm-api-reads.fantasy.espn.com/*"],
  "content_scripts": [
    {"matches":["https://fantasy.espn.com/football/draft*","https://fantasy.espn.com/football/league*","https://fantasy.espn.com/football/team*"],"js":["src/espn-main.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://fantasy.espn.com/football/draft*","https://fantasy.espn.com/football/league*","https://fantasy.espn.com/football/team*"],"js":["src/normalize.js","src/espn-content.js"],"run_at":"document_start","world":"ISOLATED"},
    {"matches":["http://localhost/*","https://happy-grass-0bcd9d60f.7.azurestaticapps.net/*"],"js":["src/app-content.js"],"run_at":"document_start","world":"ISOLATED"}
  ]
}
