# Copy to .env.local (gitignored) for local development. Leave both unset to run against the
# mock auth adapter — no vendor SDK, no keys, and every route works (see frontend/src/auth/adapter.ts).

# 'clerk' to enable real sign-in via Clerk; unset or anything else falls back to the mock adapter.
VITE_AUTH_PROVIDER=

# Required only when VITE_AUTH_PROVIDER=clerk. Publishable keys are safe to expose client-side.
VITE_CLERK_PUBLISHABLE_KEY=
