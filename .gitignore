# Dependencies
node_modules/

# Build outputs
dist/
build/
out/
.azure/
*.tsbuildinfo

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/
*.lcov

# Azure Functions
local.settings.json
bin/
obj/
.python_packages/
.func/

# Local env overrides (Clerk keys, etc.) — .env.example stays committed as the template
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets — never commit credentials
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.publishsettings
**/credentials.json
**/secrets.json
**/serviceAccount*.json

# Azure / SWA local
.azure/
swa-db.json
.swa/

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Pipeline scratch (raw upstream payloads, not the built artifacts in data/)
pipeline/.cache/
.pytest-tmp/
.pytest-fix-tmp/
.pytest-fantasy-temp*/
.tmp-pytest/

# Data staged into the frontend build by frontend/scripts/stage-data.mjs — generated
# from data/ at build time, not a second committed copy.
frontend/public/data/

# Opt-in benchmark harness output (npm run benchmark:availability) — generated
# JSON/MD reports under benchmarks/reports/, not source fixtures.
benchmarks/reports/

# Local planning scratch — PLAN.md is the committed source of truth. These Cursor
# plan-mode outputs live under archive/cursor-plans/ once a session ends (see
# archive/cursor-plans/README.md); anything still at repo root is mid-session.
archive/cursor-plans/
*_REVISED_PLAN.md
*.plan.md

# ESPN draft-day local recon captures — not contract fixtures (see fixtures/sleeper/)
fixtures/espn/

# Raw ESPN human-draft recap transcription input (see scripts/transcribe-espn-draft.py) —
# regenerable scratch, superseded by the committed fixtures/real-drafts/ output.
/espn_draft*.txt

# Append-only ADP history log — capture-only, never deployed; pipeline appends every run
data/history/

# Cursor / agent session scratch
.cursor/
.agent/
.claude/

# Misc local
*.local
.cache/
tmp/
temp/
