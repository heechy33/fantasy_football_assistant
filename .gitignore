# Local-only FantasyPros Upside/Bust/SOS decoration — display-only, never committed
# or deployed; a clean checkout naturally lacks it. Source CSVs live locally via
# --fantasypros-dir / FFA_FANTASYPROS_DIR (see pipeline/build_data.py).
data/fantasypros-stars.json
data/fantasypros-adp.json
fantasypros/
FantasyPros_*.csv

# Opt-in benchmark harness output (npm run benchmark:availability) — generated
# JSON/MD reports under benchmarks/reports/, not source fixtures.
benchmarks/reports/

# Local planning scratch — PLAN.md is the committed source of truth.
DRAFT_SCORE_WAR_ROOM_REVISED_PLAN.md
FRONTEND_OVERHAUL_PHASE_1_REVISED_PLAN.md
*_REVISED_PLAN.md
*.plan.md
espn_*.plan.md
landing_*.plan.md
live_*.plan.md
cards_*.plan.md
draft_*.plan.md
replace_*.plan.md

# ESPN draft-day local recon captures — not contract fixtures (see fixtures/sleeper/)
fixtures/espn/

# Append-only ADP history log — capture-only, never deployed; pipeline appends every run
data/history/

